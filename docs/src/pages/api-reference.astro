---
// api-reference.astro — Layer 1 landing page.
//
// Embeds the rustdoc HTML (built by scripts/build-rustdoc.sh into
// docs/public/api/) inside a full-height iframe so the browser-native
// rustdoc UI stays intact while still sitting inside the docs chrome.
import Layout from "@/layouts/Layout.astro";
import AppHeader from "@/components/AppHeader.astro";

const base = import.meta.env.BASE_URL;
const github =
  import.meta.env.PUBLIC_GITHUB_REPO_URL ?? "https://github.com/YOUR_ORG/vcli";

// The rustdoc index lives at /api/g/index.html (cargo doc emits
// target/doc/g/index.html plus sibling static.files/, crates.js, …).
const apiIndex = `${base}api/g/index.html`;
---

<Layout
  title="API Reference · g docs"
  description="Low-level Rust API reference, generated from source by rustdoc."
>
  <AppHeader base={base} github={github} />

  <div class="api-wrap">
    <nav class="doc-breadcrumb" aria-label="Breadcrumb">
      <a href={`${base}`}>Home</a>
      <span class="doc-breadcrumb-sep" aria-hidden="true">/</span>
      <a href={`${base}docs/introduction/`}>Docs</a>
      <span class="doc-breadcrumb-sep" aria-hidden="true">/</span>
      <span class="doc-breadcrumb-current">API Reference</span>
    </nav>

    <div class="api-frame-shell">
      <iframe
        id="api-frame"
        src={apiIndex}
        title="Rust API reference"
        loading="lazy"
      ></iframe>
      <div id="api-fallback" class="api-fallback" hidden>
        <div class="api-fallback-inner">
          <h2>API reference not built yet</h2>
          <p>
            The rustdoc HTML lives in <code>docs/public/api/</code> and is
            generated on demand:
          </p>
          <pre><code>cd docs && npm run docs:rustdoc</code></pre>
          <p>
            Then rebuild the site (<code>npm run build:full</code>) and this
            page will embed the full <code>cargo&nbsp;doc</code> output.
          </p>
          <a class="btn btn-primary" href={apiIndex} target="_blank" rel="noopener"
            >Open rustdoc directly →</a
          >
        </div>
      </div>
    </div>
  </div>

  <footer class="doc-footer">
    <div class="wrap-wide doc-footer-inner">
      <span>MIT · g · API reference (rustdoc)</span>
      <a href={github} rel="noopener noreferrer">Source</a>
    </div>
  </footer>

  <script>
    // Detect whether the rustdoc build has been run by probing the file with a
    // HEAD request.  Only show the fallback when it genuinely 404s — this
    // avoids false positives from iframe load-event timing quirks or rustdoc's
    // deferred JS rendering.
    const frame = document.getElementById("api-frame");
    const fallback = document.getElementById("api-fallback");
    const apiIndex = frame?.getAttribute("src");

    if (apiIndex) {
      fetch(apiIndex, { method: "HEAD" })
        .then((res) => {
          if (!res.ok) showFallback();
        })
        .catch(showFallback);
    } else {
      showFallback();
    }

    function showFallback() {
      if (frame) frame.hidden = true;
      if (fallback) fallback.hidden = false;
    }
  </script>
</Layout>

<style>
  .api-wrap {
    max-width: 100%;
    padding: 1.25rem 0 0;
  }

  .api-frame-shell {
    position: relative;
    width: 100%;
    height: calc(100vh - 9.5rem);
    min-height: 30rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow);
  }

  #api-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .api-fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
  }

  .api-fallback[hidden] {
    display: none !important;
  }

  .api-fallback-inner {
    max-width: 32rem;
    text-align: center;
    padding: 2rem;
  }

  .api-fallback-inner h2 {
    margin: 0 0 0.75rem;
    font-size: 1.3rem;
  }

  .api-fallback-inner p {
    color: var(--muted);
    line-height: 1.6;
  }

  .api-fallback-inner pre {
    text-align: left;
    margin: 1rem auto;
    max-width: fit-content;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.85rem 1.1rem;
    font-size: 0.85rem;
  }

  .api-fallback-inner .btn {
    margin-top: 1.25rem;
  }

  .doc-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0 1.5rem 1rem;
  }

  .doc-breadcrumb a {
    color: var(--muted);
    text-decoration: none !important;
  }

  .doc-breadcrumb a:hover {
    color: var(--accent);
  }

  .doc-breadcrumb-sep {
    opacity: 0.45;
    user-select: none;
  }

  .doc-breadcrumb-current {
    color: var(--text);
    font-weight: 500;
  }

  :global(.wrap-wide) {
    max-width: 90rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
</style>